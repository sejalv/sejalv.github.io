---
// pages/professional.astro
import MainLayout from '../layouts/MainLayout.astro';
import SectionNavigation from '../components/SectionNavigation.astro';
import CareerSection from '../components/CareerSection.astro';

const careerData = await import('../data/career.md');
const consultingData = await import('../data/consulting.md');
const projectData = await import('../data/projects.md');

// Define sections with their data
const sections = [
  {
    id: 'consulting',
    label: 'Consulting',
    title: 'Consulting',
    gridColumns: 3,
    items: consultingData.frontmatter.consultingHistory
  },
  {
    id: 'experience',
    label: 'Experience',
    title: 'Experience',
    gridColumns: 3,
    items: careerData.frontmatter.careerHistory
  },
  {
    id: 'projects',
    label: 'Projects',
    title: 'Projects',
    gridColumns: 3,
    items: projectData.frontmatter.projectHistory
  }
];
---

<MainLayout
    title="Professional"
    bannerImage='/assets/images/Office_Brainstorming_Session.jpg'
    bannerTitle="Professional"
    bannerDescription="Data Strategy | ML Systems | Tech Leadership"
    showBanner={true}>
    <Fragment slot="description-sub-text">
        Over 15 years, I have built ML systems to drive pricing experimentation, healthcare research, and product adoption at scale. At present, I work as a fractional leader and consult growth-stage startups and scale-ups.

        I am passionate about climate tech & sustainability, fostering an inclusive environment, and promoting gender diversity through community building.
       
    </Fragment>

  <div id="main">
      <SectionNavigation
      backgroundImage='/assets/images/business-dashboard.jpg'
      sections={sections.map(s => ({ id: s.id, label: s.label }))}>

          {sections.map((section) => (
            <>
              <span id={section.id} class="anchor-target"></span>
              <section class="section-container">
                <CareerSection id={section.id} title={section.title} gridColumns={section.gridColumns}>
                  {section.items.map((item, idx) => (
                    <article class={`career-card${section.id === 'projects' ? ' project-card' : ''}`} data-card-index={`${section.id}-${idx}`} data-href={section.id === 'projects' && item.links?.[0]?.trim() ? (item.links[0].startsWith('http') || item.links[0].startsWith('/') ? item.links[0] : `https://${item.links[0]}`) : undefined}>
                      <div class="career-content">
                        <h3>{item.company}</h3>
                        {item.period && <span class="date">{item.period}</span>}
                        {item.location && <span class="date">{item.location}</span>}
                        {item.title && <p class="job-title">{item.title}</p>}
                        {item.description && <p class="description">{item.description}</p>}
                        {item.highlights?.length > 0 && (
                          <div class="highlights">
                            <ul>
                              {item.highlights.map((hl) => (
                                <li>{hl}</li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    </article>
                  ))}
                </CareerSection>
              </section>
            </>
          ))}

        </SectionNavigation>
  </div>
</MainLayout>

<style>
  :global(section#banner.major h1) {
    font-size: 1.8em !important;
  }

  :global(section#banner) {
    padding: 4.5em 0 0.5em 0 !important;
    min-height: 14em !important;
    max-height: 24em !important;
  }

  :global(section#banner .description-sub-text) {
    font-size: 1.1rem !important;
  }

  @media screen and (max-width: 736px) {
    :global(section#banner) {
      max-height: none !important;
    }

    :global(section#banner .description-sub-text) {
      font-size: 0.95rem !important;
    }
  }

  :global(.career-card.project-card) {
    cursor: pointer;
  }

  :global(.highlights li::before) {
    content: none;
  }

  :global(.highlights li) {
    padding-left: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.project-card[data-href]').forEach((card) => {
      card.addEventListener('click', () => {
        const href = (card as HTMLElement).dataset.href;
        if (href?.toLowerCase().endsWith('.pdf')) {
          const a = document.createElement('a');
          a.href = href;
          a.download = '';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        } else {
          window.open(href, '_blank', 'noopener,noreferrer');
        }
      });
    });
  });
</script>