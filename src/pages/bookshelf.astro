---
// pages/bookshelf.astro
import MainLayout from '../layouts/MainLayout.astro';
import BookshelfPanel from '../components/BookshelfPanel.astro';
---

<MainLayout title="Bookshelf | Sejal Vaidya" showBanner={false}>
  <div id="main">
    <section id="one" class="fixed-header">
      <div class="inner">
        <header class="major">
          <h1>Bookshelf</h1>
        </header>
        <p align="left">
          Books I can recommend...
        </p>
      </div>
    </section>

    <section id="two" class="inner">
      <BookshelfPanel showTitle={false} />
    </section>
  </div>

  <style>
    .fixed-header {
      width: 100%;
      background-color: #242943;
      color: white;
      padding: 0.5rem 0;
      z-index: 10;
    }

    .fixed-header .inner {
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
      text-align: center;
    }
  </style>
</MainLayout>