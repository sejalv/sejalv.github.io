---
// layouts/MainLayout.astro
import ContactModal from '../components/ContactModal.astro';

export interface Props {
  title: string;
  description?: string;
  bannerImage?: string;
  bannerTitle?: string;
  bannerDescription?: string;
  showBanner?: boolean;
  showAbout?: boolean;
}

const {
  title,
  description,
  bannerImage,
  bannerTitle,
  bannerDescription,
  showBanner = true,
  showAbout = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <noscript><link rel="stylesheet" href="/assets/css/noscript.css" /></noscript>
    <link rel="stylesheet" href="/assets/css/scroll-buttons.css" />
    <link rel="stylesheet" href="[https://api.fontshare.com/v2/css?f](https://api.fontshare.com/v2/css?f)[]=zodiak@400,700&f[]=satoshi@400,500,700&display=swap">
    <!-- <link rel="stylesheet" href="/assets/css/theme-light.css" /> -->
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg" />
  </head>

  <body class="is-preload">
    <div id="wrapper">
      <!-- Header -->
      <header id="header" class={showBanner ? "alt" : ""}>
        <a href="/" class="logo"><strong>Sejal</strong> <span>Vaidya</span></a>
        <nav>
          <a href="#menu">Menu</a>
        </nav>
      </header>

      <!-- Menu -->
      <nav id="menu">
        <ul class="links">
          <li><a href="/">Home</a></li>
          <li><a href="/professional">Professional</a></li>
          <li><a href="/personal">Personal Notes</a></li>
        </ul>
        <ul class="icons">
          <li><a href="https://github.com/sejalv" class="icon brands alt fa-github"><span class="label">GitHub</span></a></li>
          <li><a href="https://www.linkedin.com/in/vaidyasejal/" target="_blank" rel="noopener noreferrer" class="icon brands alt fa-linkedin-in"><span class="label">LinkedIn</span></a></li>
        </ul>
      </nav>
      
      {showBanner && (
        <section id="banner" class="major" style={`background-image: url(${bannerImage})`}>
          <div class="inner">
            <header class="major">
              <h1>{bannerTitle}</h1>
            </header>
            <div class="content">
              <p>{bannerDescription}</p>
            </div>
            <p class="description-sub-text">
              <slot name="description-sub-text" />
            </p>
          </div>
        </section>
      )}

      <slot name="before-about" />
      {showAbout && <section id="about" class="about-section" style="background-image: url('/assets/images/pic07.jpg');">
        <div class="inner">
          <div class="about-content">
            <div class="about-text">
              <header class="major">
                <h2>About Me</h2>
              </header>
              I am a Data & ML Engineering professional, living in Berlin.
              I own production ML systems from roadmap and evaluation to production rollout, and keep model metrics tied to business outcomes.
              </br></br>
              I care about sustainability, social impact and inclusive teams. I speak and mentor in Berlin's tech communities and promote gender diversity through community building. 
              </br></br>
              I'm open to Senior/Staff ML Engineering roles in Berlin and remote EU, and to selected consulting on data strategy and ML platforms.
              <!-- If you are looking for a consultation on your data strategy, ML platforms, or a collaboration on a project, feel free to reach out here. -->
            </div>
            <div class="about-image">
              <img src="/assets/images/profile_sv.jpg" alt="Sejal Vaidya" />
            </div>
          </div>
          <ul class="actions about-actions">
            <li><a href="#contact-modal" class="button primary contact-modal-trigger">Contact</a></li>
            <li><a href="https://www.linkedin.com/in/vaidyasejal/" target="_blank" rel="noopener noreferrer" class="button icon brands fa-linkedin-in">LinkedIn</a></li>
          </ul>
        </div>
      </section>}

      <!-- Main Content -->
      <div id="main">
        <slot />
      </div>

      <!-- Contact Modal -->
      <ContactModal />

      <!-- Footer -->
      <footer id="footer">
        <div class="inner">
          <ul class="copyright">
            <li>&copy; Sejal Vaidya</li>
            <li>All rights reserved.</li>
          </ul>
        </div>
      </footer>
    </div>

    <!-- Scripts -->
    <script is:inline src="/assets/js/jquery.min.js"></script>
    <script is:inline src="/assets/js/jquery.scrolly.min.js"></script>
    <script is:inline src="/assets/js/jquery.scrollex.min.js"></script>
    <script is:inline src="/assets/js/browser.min.js"></script>
    <script is:inline src="/assets/js/breakpoints.min.js"></script>
    <script is:inline src="/assets/js/util.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
    <script is:inline src="/assets/js/smooth-scroll.js"></script>

    <style>
      .description-sub-text {
          white-space: pre-line;
      }

      /* About section styles 
        background-color: #F6F1E7;
      */
      .about-section {
        margin-top: 0;
        position: relative;
        background-color: #F6F1E7;
        background-image: none !important;
      }

      .about-section::before {
        display: none;
      }

      .about-section .inner {
        padding-top: 0.25rem;
        padding-bottom: 0.25rem;
      }

      .about-content {
        display: flex;
        align-items: center;
        gap: 2rem;
        max-width: 100%;
      }

      .about-actions {
        gap: 2.25em;
        margin: 2.5rem 0 0;
      }

      .about-actions li {
        padding-left: 0;
      }

      .about-actions .button {
        font-size: 0.8em;
        height: 3.2em;
        line-height: 3.2em;
        padding: 0 1.4em;
      }

      .about-text {
        flex: 1;
        text-align: left;
        font-weight: 400;
      }

      .about-image {
        flex-shrink: 0;
        width: 350px;
        height: 400px;
        border-radius: 8px;
        overflow: hidden;
        border: none;
        transform: translateX(4rem);
      }

      .about-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 70% !important;
      }

      /* Tablet responsiveness for About section */
      @media screen and (max-width: 980px) {
        .about-section {
          min-height: 40vh;
          height: auto;
        }

        .about-image {
          width: 260px;
          height: 320px;
          transform: none;
        }
      }

      /* Mobile responsiveness for About section */
      @media screen and (max-width: 736px) {
        .about-section {
          min-height: unset;
          height: auto;
          padding: 0;
        }

        .about-content {
          align-items: flex-start;
          flex-direction: column;
        }

        .about-image {
          align-self: center;
          width: min(100%, 300px);
          height: auto;
          aspect-ratio: 2 / 3;
        }
      }

      /* Footer */
      #footer .inner {
        display: flex;
        align-items: center;
        padding: 2em 0 1.25em 0 !important;
      }

      #footer .copyright {
        margin-bottom: 0;
      }

      @media screen and (max-width: 736px) {
        #footer .inner {
          align-items: flex-start;
          flex-direction: column;
          gap: 1em;
          padding: 1.5em 0 1em 0 !important;
        }

      }
    </style>
  </body>
</html>
